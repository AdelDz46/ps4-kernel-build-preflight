+static int ps4_bridge_read_status_reg(struct ps4_bridge *mn_bridge,
+				      u16 addr, u8 *value)
+{
+	int ret;
+
+	cq_init(&mn_bridge->cq, 4);
+	cq_read(&mn_bridge->cq, addr, 1);
+	ret = cq_exec(&mn_bridge->cq);
+	if (ret < 9)
+		return ret < 0 ? ret : -EIO;
+
+	*value = mn_bridge->cq.reply.databuf[3];
+	return ret;
+}
+
+void ps4_bridge_probe_lane_status(struct drm_connector *connector,
+				  const char *tag)
+{
+	struct ps4_bridge *mn_bridge = &g_bridge;
+	u8 lane_status, link_state;
+	int lane_ret, link_ret;
+
+	if (!connector || READ_ONCE(mn_bridge->connector) != connector)
+		return;
+
+	mutex_lock(&mn_bridge->mutex);
+	if (mn_bridge->connector != connector) {
+		mutex_unlock(&mn_bridge->mutex);
+		return;
+	}
+	lane_ret = ps4_bridge_read_status_reg(mn_bridge, 0x60f8, &lane_status);
+	link_ret = ps4_bridge_read_status_reg(mn_bridge, 0x60f9, &link_state);
+	mutex_unlock(&mn_bridge->mutex);
+
+	if (lane_ret >= 0)
+		DRM_INFO("ps4diag: lane probe %s: 0x60f8=0x%02x (rc=%d)\n",
+			 tag, lane_status, lane_ret);
+	else
+		DRM_INFO("ps4diag: lane probe %s: 0x60f8 read failed rc=%d\n",
+			 tag, lane_ret);
+	if (link_ret >= 0)
+		DRM_INFO("ps4diag: lane probe %s: 0x60f9=0x%02x (rc=%d)\n",
+			 tag, link_state, link_ret);
+	else
+		DRM_INFO("ps4diag: lane probe %s: 0x60f9 read failed rc=%d\n",
+			 tag, link_ret);
+}
